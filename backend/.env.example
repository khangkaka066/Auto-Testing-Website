PORT=5001
MONGO_URL="mongodb+srv://cluster-url/database?retryWrites=true&w=majority"
DB_NAME="testpilot_db"
CORS_ORIGINS=*

# OpenAI API key (dùng cho toàn bộ AI pipeline)
OPENAI_API_KEY="your-openai-api-key"

# Cấu hình AI pipeline
AI_DEBUG=false
AI_MAX_WORKERS=4
AI_CACHE_ENABLED=true
AI_RETRY_COUNT=3

# Đường dẫn workspace (lưu source code & kết quả pipeline)
WORKSPACE_BASE_PATH=workspaces
SOURCE_WORKSPACE_BASE_PATH=uploaded_sources
UPLOAD_ARCHIVE_BASE_PATH=uploaded_archives

# URL mặc định của app cần test
TARGET_BASE_URL=http://localhost:5173
