            "purpose": "Open modal for selecting products by category"
        },
        {
            "element_type": "Button",
            "selector": ".btn.btn-sm.btn-outline-danger[onClick*=removeFromBuild]",
            "purpose": "Remove a selected item from the build"
        },
        {
            "element_type": "Button",
            "selector": ".btn.btn-danger[onClick*=clearAllSelected][disabled*='selectedItems.length === 0']",
            "purpose": "Clear all selected items"
        },
        {
            "element_type": "Button",
            "selector": ".btn.btn-success[onClick*=addAllSelectedToCart][disabled*='selectedItems.length === 0']",
            "purpose": "Add all selected items to the cart"
        }
    ],
