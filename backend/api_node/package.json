{
  "name": "testpilot-backend",
  "version": "1.0.0",
  "description": "Backend API server cho TestPilot - chuyển đổi từ FastAPI Python sang Node.js Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:all": "node scripts/start-all.js",
    "start:ai": "cd ../ai_engine && python3 -m uvicorn app:app --host 127.0.0.1 --port 8001",
    "dev": "nodemon server.js",
    "lint": "eslint server.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.7.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "express",
    "api",
    "fastapi",
    "nodejs"
  ],
  "author": "",
  "license": "ISC"
}
